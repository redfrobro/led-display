#!/usr/bin/env python3
"""Set or remove the web UI password

Stores a salted PBKDF2 hash (werkzeug format) in web_password; the web server
asks for this password (HTTP Basic Auth, any username) whenever the file exists.

Usage:
    bin/led-web-password            # Set or change the password
    bin/led-web-password --remove   # Remove it (web UI open to everyone again)
"""

import os
import sys
import getpass
import hashlib
import secrets

PROJECT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PASSWORD_FILE = os.path.join(PROJECT_DIR, 'web_password')
ITERATIONS = 200000


def hash_password(password):
    salt = secrets.token_hex(8)
    digest = hashlib.pbkdf2_hmac('sha256', password.encode('utf-8'), salt.encode('utf-8'), ITERATIONS).hex()
    return f"pbkdf2:sha256:{ITERATIONS}${salt}${digest}"


def main():
    if sys.argv[1:] == ['--remove']:
        try:
            os.unlink(PASSWORD_FILE)
            print("Web UI password removed; anyone on the network can use the web UI.")
        except FileNotFoundError:
            print("No web UI password is set.")
        return 0
    if sys.argv[1:]:
        print(__doc__.strip())
        return 1

    password = getpass.getpass("New web UI password: ")
    if not password:
        print("Error: password cannot be empty")
        return 1
    if getpass.getpass("Repeat password: ") != password:
        print("Error: passwords do not match")
        return 1

    # Create owner-only, then replace atomically so the old file is never half-written
    temp_path = PASSWORD_FILE + '.tmp'
    try:
        os.unlink(temp_path)
    except FileNotFoundError:
        pass
    fd = os.open(temp_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(hash_password(password) + "\n")
    os.replace(temp_path, PASSWORD_FILE)
    print(f"Web UI password saved to {PASSWORD_FILE}")
    print("Takes effect immediately; log in with any username and this password.")
    return 0


if __name__ == '__main__':
    sys.exit(main())
